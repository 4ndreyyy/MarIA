<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RegistroController"
      alignment="CENTER"
      spacing="12"
      prefWidth="380"
      style="-fx-background-color: #101722;">
    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <Label text="Crear cuenta"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <TextField fx:id="usernameField" promptText="Nombre de usuario"/>
    <TextField fx:id="nombreField" promptText="Nombre"/>
    <TextField fx:id="apellidosField" promptText="Apellidos"/>
    <TextField fx:id="correoField" promptText="Correo electrónico"/>
    <PasswordField fx:id="passwordField" promptText="Contraseña (mínimo 8 caracteres)"/>

    <Button text="Registrar" onAction="#registrar"
            style="-fx-background-color: #18a6a6; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Label fx:id="mensajeLabel" wrapText="true"
           style="-fx-text-fill: #e8eef5;"/>
</VBox>