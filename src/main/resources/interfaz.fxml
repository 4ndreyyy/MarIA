<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ChatController"
            prefWidth="1180.0"
            prefHeight="780.0"
            minWidth="900.0"
            minHeight="640.0"
            styleClass="app-shell"
            stylesheets="@marIA.css">

    <top>
        <VBox fx:id="headerBox" styleClass="app-header">

            <HBox fx:id="windowTitleBar"
                  alignment="CENTER_LEFT"
                  spacing="10.0"
                  styleClass="window-titlebar"
                  onMousePressed="#iniciarArrastreVentana"
                  onMouseDragged="#arrastrarVentana">

                <Label text="✦" styleClass="titlebar-mark"/>
                <Label text="MarIA" styleClass="window-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button id="windowMinimizeButton"
                        text="—"
                        onAction="#minimizarVentana"
                        styleClass="window-titlebar-button"/>

                <Button fx:id="maximizeButton"
                        id="maximizeButton"
                        text="□"
                        onAction="#alternarMaximizarVentana"
                        styleClass="window-titlebar-button"/>

                <Button id="windowCloseButton"
                        text="×"
                        onAction="#cerrarVentana"
                        styleClass="window-titlebar-button"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <padding>
                    <Insets top="10.0" right="28.0" bottom="18.0" left="28.0"/>
                </padding>

                <Button fx:id="historyToggleButton"
                        text="☰"
                        onAction="#alternarHistorial"
                        styleClass="icon-button"/>

                <Label text="✦" styleClass="brand-mark"/>

                <VBox spacing="3.0">
                    <Label fx:id="appTitleLabel"
                           text="MarIA"
                           styleClass="app-title"/>
                    <Label fx:id="subtitleLabel"
                           text="Tu asistente de IA, en tu espacio"
                           styleClass="app-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="5.0" styleClass="mode-control">
                    <Label fx:id="modeLabel"
                           text="MODO ACTIVO"
                           styleClass="eyebrow-label"/>
                    <ComboBox fx:id="specialtyCombo"
                              prefWidth="170.0"
                              styleClass="specialty-combo"/>
                </VBox>

                <Button fx:id="settingsButton"
                        text="⚙  Preferencias"
                        onAction="#abrirPreferencias"
                        styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="18.0" styleClass="workspace">
            <BorderPane.margin>
                <Insets top="18.0" right="24.0" bottom="12.0" left="24.0"/>
            </BorderPane.margin>

            <VBox fx:id="historyBox"
                  spacing="12.0"
                  prefWidth="250.0"
                  minWidth="210.0"
                  maxWidth="285.0"
                  styleClass="history-panel">
                <Label fx:id="historyTitleLabel"
                       text="Mis conversaciones"
                       styleClass="history-title"/>

                <Button fx:id="newChatButton"
                        text="＋  Nuevo chat"
                        onAction="#nuevoChat"
                        maxWidth="Infinity"
                        styleClass="primary-button"/>

                <Label fx:id="recentLabel"
                       id="recentLabel"
                       text="RECIENTES"
                       styleClass="eyebrow-label"/>

                <ListView fx:id="historyList"
                          id="historyList"
                          VBox.vgrow="ALWAYS"
                          styleClass="history-list"/>
            </VBox>

            <WebView fx:id="chatView"
                     HBox.hgrow="ALWAYS"/>
        </HBox>
    </center>

    <bottom>
        <VBox fx:id="inputArea" spacing="10.0" styleClass="composer-area">
            <padding>
                <Insets top="4.0" right="28.0" bottom="20.0" left="28.0"/>
            </padding>

            <HBox spacing="9.0"
                  alignment="CENTER_LEFT"
                  styleClass="attachment-row">
                <Button fx:id="attachButton"
                        id="attachButton"
                        text="＋  Adjuntar archivo"
                        onAction="#adjuntarArchivo"
                        styleClass="secondary-button"/>

                <Label fx:id="attachmentLabel"
                       text="Sin archivo adjunto"
                       styleClass="attachment-label"/>

                <Button fx:id="removeButton"
                        text="Quitar"
                        onAction="#quitarArchivo"
                        styleClass="text-button"/>
            </HBox>

            <HBox spacing="10.0"
                  alignment="CENTER"
                  styleClass="composer-row">
                <TextField fx:id="questionField"
                           promptText="Escribe tu pregunta…"
                           onAction="#sendQuestion"
                           HBox.hgrow="ALWAYS"
                           styleClass="question-field"/>

                <Button fx:id="sendButton"
                        id="sendButton"
                        text="Enviar  ↑"
                        onAction="#sendQuestion"
                        defaultButton="true"
                        styleClass="primary-button"/>
            </HBox>

            <Label fx:id="footerLabel"
                   text="La clave API se lee desde las variables de entorno de Windows."
                   styleClass="footer-label"/>
        </VBox>
    </bottom>
</BorderPane>